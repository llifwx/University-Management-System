POSTGRES_USER=university
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=university
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Marks session cookies Secure. Set true when the frontend is served over HTTPS.
COOKIE_SECURE=false
# Origin the browser uses to open the support chat's WebSocket directly against the backend
# (bypassing the BFF proxy, since it cannot tunnel a WebSocket upgrade). Must be reachable from
# the browser, not just inside Docker. Change the host when deploying behind a real domain.
CHAT_WS_URL=ws://localhost:8000/api/v1
DATABASE_URL=postgresql+asyncpg://university:replace-with-a-local-database-password@localhost:5432/university
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Used only by the explicit bootstrap/seed commands. Set your own values.
BOOTSTRAP_ADMIN_EMAIL=admin@example.edu
BOOTSTRAP_ADMIN_PASSWORD=
SEED_PASSWORD=
# Separate disposable PostgreSQL database; its database name must end in _test.
TEST_DATABASE_URL=postgresql+asyncpg://university:replace-with-a-local-database-password@localhost:5432/university_test
